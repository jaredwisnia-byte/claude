{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredwisnia-byte/claude/blob/claude/trusting-dirac-bxfmv6/long-lines/factory/schemas/asset_schema.json",
  "title": "Long Lines FACTORY_V1 asset package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "asset_id",
    "brief",
    "maps",
    "depth_range_m",
    "panels",
    "orthographic_views",
    "assembly_file"
  ],
  "properties": {
    "format": {
      "const": "FACTORY_V1"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "era",
        "style",
        "condition",
        "dimensions_m"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "era": {
          "type": "string",
          "minLength": 3
        },
        "style": {
          "type": "string",
          "minLength": 5
        },
        "condition": {
          "type": "string",
          "enum": [
            "new",
            "lightly_worn",
            "worn",
            "derelict"
          ]
        },
        "dimensions_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "depth",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 40
            }
          }
        }
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas_px",
        "pixels_per_metre",
        "albedo",
        "signed_depth",
        "part_ids",
        "orthographic",
        "concept",
        "reference_pixel_scale",
        "reference_canvas_px"
      ],
      "properties": {
        "canvas_px": {
          "$ref": "#/$defs/pixel_pair"
        },
        "pixels_per_metre": {
          "type": "number",
          "minimum": 16,
          "maximum": 8192
        },
        "albedo": {
          "$ref": "#/$defs/relative_png"
        },
        "signed_depth": {
          "$ref": "#/$defs/relative_png"
        },
        "part_ids": {
          "$ref": "#/$defs/relative_png"
        },
        "orthographic": {
          "$ref": "#/$defs/relative_png"
        },
        "concept": {
          "$ref": "#/$defs/relative_png"
        },
        "reference_pixel_scale": {
          "type": "number",
          "minimum": 16,
          "maximum": 8192
        },
        "reference_canvas_px": {
          "$ref": "#/$defs/pixel_pair"
        }
      }
    },
    "depth_range_m": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inward",
        "outward"
      ],
      "properties": {
        "inward": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "outward": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "part_id",
          "face",
          "rect_px",
          "size_m",
          "origin_m",
          "u_axis",
          "v_axis"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/name"
          },
          "part_id": {
            "$ref": "#/$defs/name"
          },
          "face": {
            "type": "string",
            "enum": [
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom",
              "custom"
            ]
          },
          "rect_px": {
            "$ref": "#/$defs/pixel_rect"
          },
          "size_m": {
            "$ref": "#/$defs/positive_pair"
          },
          "origin_m": {
            "$ref": "#/$defs/vector3"
          },
          "u_axis": {
            "$ref": "#/$defs/vector3"
          },
          "v_axis": {
            "$ref": "#/$defs/vector3"
          },
          "curve": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "flat",
                  "cylinder"
                ]
              },
              "axis": {
                "type": "string",
                "enum": [
                  "u",
                  "v"
                ]
              },
              "radius_m": {
                "type": "number"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "orthographic_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "front",
        "right",
        "back",
        "left",
        "top",
        "bottom"
      ],
      "properties": {
        "front": {
          "$ref": "#/$defs/pixel_rect"
        },
        "right": {
          "$ref": "#/$defs/pixel_rect"
        },
        "back": {
          "$ref": "#/$defs/pixel_rect"
        },
        "left": {
          "$ref": "#/$defs/pixel_rect"
        },
        "top": {
          "$ref": "#/$defs/pixel_rect"
        },
        "bottom": {
          "$ref": "#/$defs/pixel_rect"
        }
      }
    },
    "assembly_file": {
      "type": "string",
      "const": "assembly.json"
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "relative_png": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[a-zA-Z0-9_./-]+\\.png$"
    },
    "pixel_pair": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 16,
        "maximum": 16384
      },
      "minItems": 2,
      "maxItems": 2
    },
    "positive_pair": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "pixel_rect": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
